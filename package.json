{
  "name": "@3xjn/roblox-client-mcp",
  "version": "0.2.0",
  "description": "Generic stdio MCP for inspecting a live Roblox client (not Studio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3xjn/roblox-client-mcp.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "check:luau": "bun run scripts/check-luau.ts",
    "check": "bun run typecheck && bun run lint && bun run check:luau && bun test",
    "benchmark": "bun run scripts/benchmark.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "1.3.4",
    "luau-web": "1.5.1",
    "typescript": "5.9.3"
  }
}
